# Server secrets. Everything a workspace can change (playbook, limits, language) lives in the
# database instead, so a fresh install of the desktop app is configured by logging in.

DATABASE_URL=postgresql+psycopg://sidekick:sidekick@localhost:55432/sidekick

# Signs the tokens the desktop app holds. Change it and everyone has to log in again.
JWT_SECRET=change-me-in-production

# Vendor keys. Laptops never hold these: the app asks for a short-lived Deepgram key per call
# and sends its Claude requests through this server.
# The Deepgram key must have the 'keys:write' scope, or it can't mint the short-lived ones.
# ANTHROPIC_API_KEY=
# DEEPGRAM_API_KEY=

# The workspace's CRM (Twenty): the desktop app reaches it through this server, so reps need no
# CRM key of their own.
# TWENTY_BASE_URL=https://crm.example.com
# TWENTY_API_KEY=

# App updates: where published installers are kept, and the address the desktop app reaches this
# server on (the update file hands out a download URL built from it).
# UPDATES_DIR=data/updates
# PUBLIC_URL=https://sidekick.example.com
