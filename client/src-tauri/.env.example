# Copy to .env and fill in. .env is git-ignored.
DEEPGRAM_API_KEY=
# Deepgram language code: en (default), en-IN (Indian English), multi (Hindi-English code-switching)
DEEPGRAM_LANGUAGE=en

# Live coaching model (Claude Haiku 4.5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Post-call summary model and its list prices (USD per 1M tokens)
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5
SUMMARY_PRICE_INPUT_PER_MTOK=2.00
SUMMARY_PRICE_OUTPUT_PER_MTOK=10.00

# Calls end automatically after this long, or after this long with no speech (not counting
# time paused), in case Stop is forgotten.
CALL_MAX_MINUTES=180
CALL_AUTO_STOP_SILENCE_MINUTES=15
# ...or once it has spent this much (USD) on hints and transcription. Needs the prices below.
# The app warns about a minute before any of these ends a call.
CALL_MAX_COST_USD=5

# Streamed STT is billed per second: stretches with nobody speaking aren't sent. Set to off
# to send all audio (e.g. to compare transcript accuracy).
STT_SILENCE_GATE=on

# Experimental: echo cancellation on the mic (Windows Voice Capture DSP), so the prospect's
# voice from the speakers isn't transcribed as you. Not yet measured on speakers; headphones
# avoid the problem entirely.
MIC_ECHO_CANCELLATION=off

# Call detection: offer to start coaching when Zoom, Teams, a browser, etc. starts using the
# microphone. Set to off to disable. Extra call apps by exe name, comma-separated.
CALL_DETECTION=on
# CALL_DETECTION_EXTRA_APPS=softphone.exe

# Sidekick backend: sign in there to get the workspace's settings and to send finished calls.
# Leave it unset to keep everything on this machine.
# SIDEKICK_BACKEND_URL=http://localhost:8000

# CRM (Twenty): where a finished call is written, as an Opportunity record.
# TWENTY_BASE_URL=https://crm.example.com
# TWENTY_API_KEY=...

# Optional: playbook file for coaching context (default: playbook/sales.md)
# PLAYBOOK_PATH=playbook/sales.md

# Pricing used for the cost log (USD). Leave unset to log tokens without cost.
# Claude Haiku 4.5 list prices; Deepgram Nova-3 streaming (English promo; multilingual is 0.0058).
LLM_PRICE_INPUT_PER_MTOK=1.00
LLM_PRICE_CACHE_WRITE_PER_MTOK=1.25
LLM_PRICE_CACHE_READ_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=5.00
STT_PRICE_PER_MINUTE=0.0048
# Deepgram's listed rates assume audio may be kept for model training. Calls opt out by
# default (DEEPGRAM_MIP_OPT_OUT=off to allow it), which doubles the STT rate in the cost log
# unless you set the opt-out rate here.
# STT_PRICE_PER_MINUTE_OPT_OUT=0.0096
