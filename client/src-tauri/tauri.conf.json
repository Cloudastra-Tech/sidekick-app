{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidekick",
  "version": "0.4.0",
  "identifier": "com.sidekick.callcoach",
  "build": {
    "beforeDevCommand": {
      "script": "node scripts/ui-build-if-changed.mjs",
      "cwd": "..",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sidekick — Live Call Coach",
        "width": 1200,
        "height": 800
      },
      {
        "label": "overlay",
        "title": "Sidekick hints",
        "url": "overlay/",
        "width": 360,
        "height": 430,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "playbook/sales.md": "playbook/sales.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNzU1NEZCMzc4OEYzOUEKUldTYTg0ZzMrMVIxTUJlcEtGREtuQjluNkNVYzlzS0JXTEZJL1FXblhwelRSdHJNWWVNTC84bEsK",
      "endpoints": [
        "https://updates.invalid/updates/latest?target={{target}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
